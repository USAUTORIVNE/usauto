# Neon Postgres connection string
# https://console.neon.tech → Project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Пароль для входу в панель заявок /admin
ADMIN_PASSWORD=

# Довільний секрет для читання заявок через GET /api/leads (header: x-admin-token)
ADMIN_TOKEN=

# Трекінг на /thank-you (опційно — для таргетолога)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=1234567890
# NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GADS_CONVERSION_LABEL=AbCdEfGhIjKlMnOpQrSt
