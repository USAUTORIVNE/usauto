# Публічна адреса сайту (для SEO, sitemap, Open Graph)
# NEXT_PUBLIC_SITE_URL=https://usauto.com.ua

# Neon Postgres connection string
# https://console.neon.tech → Project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Пароль для входу в панель заявок /admin
ADMIN_PASSWORD=

# Довільний секрет для читання заявок через GET /api/leads (header: x-admin-token)
ADMIN_TOKEN=

# Telegram-сповіщення про нові заявки (опційно)
# 1) @BotFather → /newbot → TELEGRAM_BOT_TOKEN
# 2) Напишіть боту /start, потім відкрийте:
#    https://api.telegram.org/bot<TOKEN>/getUpdates → chat.id
# TELEGRAM_BOT_TOKEN=
# Один або кілька chat id через кому (тільки ці люди отримують заявки):
# TELEGRAM_CHAT_ID=447596610,450170731

# Трекінг (опційно — для таргетолога)
# Meta Pixel — на всіх сторінках (PageView) + Lead на /thank-you
NEXT_PUBLIC_META_PIXEL_ID=1360021618212038
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GADS_CONVERSION_LABEL=AbCdEfGhIjKlMnOpQrSt
